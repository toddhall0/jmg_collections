# Server Configuration
PORT=3001

# JWT Secret - use a strong random string in production
JWT_SECRET=your-secret-key-change-in-production

# Database file location (optional, defaults to ./data/collections.db)
# IMPORTANT: Set this to a persistent location outside the app directory
# to preserve data across deployments. Use an absolute path.
# Example: DATABASE_PATH=/var/data/collections.db
# DATABASE_PATH=./data/collections.db
